# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# volcado de 11MB, no va al repo
estructura.txt

# Supabase CLI: estado local de la maquina (project-ref, pooler-url, versiones).
# No va al repo: es por-maquina y por-cliente, y cambia con cada comando del CLI.
supabase/.temp/
supabase/.branches/

# Respaldos de la base. NUNCA deben entrar al repo: llevan datos de produccion.
respaldo_*.sql
backup_*.sql
*.dump
