node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Desktop.ini
public/Desktop.ini
*.pem
rollback_hardening_profiles.sql

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
